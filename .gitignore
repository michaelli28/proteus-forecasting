node_modules/
dist/
.next/
*.tsbuildinfo

# Credentials
.env
.env.*
!.env.example

# Run artifacts — content-addressed, regenerated by any run.
# Broad on purpose: --store takes an arbitrary directory, and an artifact tree
# committed by accident is ~57 KB of event log per run. Convention: any --store
# directory is dot-prefixed, and the patterns below cover the ones the docs use.
*artifacts*/
.case*/
.demo*/
.run*/

# Playwright — browsers, traces, screenshots and reports are all regenerated by
# `npm run e2e` in dashboard/. The spec files themselves ARE committed.
dashboard/test-results/
dashboard/e2e-report/
dashboard/e2e-shots/
dashboard/playwright-report/
dashboard/blob-report/

# Caches
.c4tmp/
.DS_Store

# Python consequence twin — the venv and EPANET-solved tables are regenerated
# by `npm run consequence:build`, never committed. The table is ~200 KB of
# machine output and the venv is hundreds of MB.
engine/.venv/
engine/.cache/
__pycache__/
.pytest_cache/

# EPANET writes .inp/.rpt/.bin scratch next to cwd when a solve is not sandboxed
# to a temp dir; regenerable, never committed.
engine/temp.*
*.inp
*.rpt

# Python
.venv/
