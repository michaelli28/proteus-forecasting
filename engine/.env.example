# Required for any run with a model in the loop (framer, panel, red team).
# Every run works without it via --offline, which uses the uniform-partition fallback.
ANTHROPIC_API_KEY=

# Optional. No engine code reads it; `npm run preflight` probes it so a bad
# subscription token is distinguishable from a bad API key.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. Alternate backends, kept for the model-agnosticism comparison.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
