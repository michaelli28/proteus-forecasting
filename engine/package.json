{
  "name": "proteus-engine",
  "version": "0.1.0",
  "description": "Calibrated forecasting against a simulated world, with an evidence-gated abstention path",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli.ts",
    "preflight": "node scripts/preflight.mjs",
    "bench": "PROTEUS_BENCH=1 vitest run tests/benchmark/calibration",
    "snapshot": "PROTEUS_BENCH=1 PROTEUS_SNAPSHOT_OUT=../dashboard/data/benchmark-snapshot.json vitest run tests/benchmark/calibration",
    "traces": "tsx src/cli.ts trace --all --out ../dashboard/data/run-traces.json"
  },
  "bin": {
    "proteus": "./dist/cli.js"
  },
  "license": "ISC",
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
